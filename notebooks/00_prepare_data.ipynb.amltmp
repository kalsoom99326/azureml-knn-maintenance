    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from ucimlrepo import fetch_ucirepo\n",
        "\n",
        "ds = fetch_ucirepo(id=601)   # 601 = AI4I 2020 Predictive Maintenance\n",
        "df_raw = pd.concat([ds.data.features, ds.data.targets], axis=1)\n",
        "\n",
        "print(\"Shape:\", df_raw.shape)\n",
        "print(\"Columns:\", df_raw.columns.tolist())\n",
        "df_raw.head()"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
